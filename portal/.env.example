APP_ENV=local
AUTH_MODE=demo
DATABASE_URL=sqlite:///.data/nawa.db
DATA_DIR=.data
SEED_DEMO=true
WEB_ORIGIN=http://localhost:5173
MODEL_MODE=extractive
OCR_MODE=auto
OCR_LANGUAGES=eng+ara
OCR_MAX_PAGES=6
RETRIEVAL_MODE=lexical
# Optional free hybrid BM25 + local dense model. No paid fallback.
# RETRIEVAL_MODE=hybrid
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_MODEL=embeddinggemma:300m
# EMBEDDING_ALLOWED_CLASSIFICATIONS=synthetic
# RETRIEVAL_MAX_CHUNKS=240
# RETRIEVAL_MIN_COSINE=0.45
# Optional hosted route. Never commit real credentials.
# MODEL_MODE=hosted
# MODEL_BASE_URL=https://approved-provider.example/v1
# MODEL_NAME=your-approved-model
# MODEL_API_KEY=enter-securely
# MODEL_ALLOWED_HOSTS=approved-provider.example
# MODEL_ALLOWED_CLASSIFICATIONS=synthetic
# For deployed OIDC: disable demo seeding; provision users with the CLI.
# AUTH_MODE=oidc
# APP_ENV=production
# OIDC_ISSUER=https://identity.example/realms/nawa
# OIDC_CLIENT_ID=nawa
# OIDC_CLIENT_SECRET=enter-securely
# OIDC_REDIRECT_URI=https://workspace.example/auth/callback
# WEB_ORIGIN=https://workspace.example


# Optional free local model; read docs/implementation/19_FREE_LOCAL_SERVICES.md.
# MODEL_MODE=ollama
# MODEL_BASE_URL=http://127.0.0.1:11434/v1
# MODEL_NAME=qwen2.5:1.5b
# MODEL_ALLOWED_CLASSIFICATIONS=synthetic
