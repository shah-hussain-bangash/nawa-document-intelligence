{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "python.analysis.extraPaths": ["${workspaceFolder}/backend/src"],
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests/integration"],
  "python.envFile": "${workspaceFolder}/.env",
  "editor.formatOnSave": true,
  "[typescript]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
  "[typescriptreact]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
  "[css]": {"editor.defaultFormatter": "esbenp.prettier-vscode"},
  "prettier.configPath": "${workspaceFolder}/apps/web/.prettierrc.json",
  "search.exclude": {"**/.venv/**": true, "**/node_modules/**": true, "**/artifacts/**": true, "**/.data/**": true},
  "files.watcherExclude": {"**/.venv/**": true, "**/node_modules/**": true, "**/.data/**": true},
  "files.associations": {"*.mdc": "markdown"}
}
