digraph architecture {
graph [rankdir=LR, bgcolor="#F5F8FC", fontname="DejaVu Sans", fontsize=22, fontcolor="#12374A", pad=0.45, nodesep=0.34, ranksep=0.65, compound=true, splines=polyline, labelloc=t, labeljust=l];
node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#C3D1DD", fontname="DejaVu Sans", fontsize=12, fontcolor="#18374A", margin="0.18,0.12", penwidth=1.2];
edge [color="#58738A", fontname="DejaVu Sans", fontsize=9, fontcolor="#426077", arrowsize=0.7, penwidth=1.2];

label="06  /  DELIVERY PIPELINE, EVALUATION & OPERATING LIFECYCLE\lSecurity, tests and documentation are continuous; promotion requires recorded evidence\l";
subgraph cluster_build {
label="DEVELOPMENT & CI";style="rounded,filled";fillcolor="#EBF2FA";color="#91A6C9";
source [label="Git repository\nCode • Locks • Migrations • Contracts\nPrompts / rules • Synthetic manifests"];
ci [label="Locked install / build\nLint / types • Unit / integration / UI\nTenant / approval security tests"];
scan [label="Dependency / image scans\nSBOM • Artifact integrity\nNo secrets in code / image / logs"];
artifact [label="Immutable release artifact\nDigest + schema + config manifest",fillcolor="#DCE4F6"];
source -> ci -> scan -> artifact;
}
subgraph cluster_eval {
label="AI / ML QUALITY GATES";style="rounded,filled";fillcolor="#F1EDFA";color="#A99ACC";
dataset [shape=cylinder,label="Reviewed versioned datasets\nArabic / English • Held-out split\nFields • Citations • Adversarial cases"];
eval [label="Controlled live-model evaluation\nRetrieval / citation / answer / extraction\nWorkflow recovery • Cost / latency"];
redteam [label="Red team / release decision\nLeakage • Injection • Tool misuse\nMandatory failures block release"];
dataset -> eval -> redteam;
}
subgraph cluster_release {
label="PROMOTION & OPERATIONS";style="rounded,filled";fillcolor="#EAF6F4";color="#74ABA9";
stage [label="Staging + safe migration\nFull synthetic end-to-end smoke"];
pilot [label="Arabic / English user acceptance\nPilot • Scope / operating approval"];
release [label="Authorised release / canary\nSame tested artifact\nRollback triggers & owner"];
observe [label="Redacted operational visibility\nErrors • Queue age • Cost • Quality\nReview backlog • Capacity alerts"];
recover [label="Recovery & incident operations\nBackup restore • Rollback • Reconcile\nRTO / RPO evidence • Revocations"];
improve [label="Reviewed improvement / handover\nAccess review • Patches • Drift\nSanitised portfolio • Retirement plan"];
stage -> pilot -> release -> observe -> recover -> improve;
}
source -> dataset [style=dashed,label="versioned manifests"];
artifact -> stage;redteam -> stage [label="gates pass"];
observe -> eval [style=dashed,label="reviewed feedback; preserve hold-out"];
improve -> source [style=dashed,label="next controlled change"];
iac [label="INFRASTRUCTURE AS CODE\nNetwork / IAM • Secrets / keys\nPrivate DB / storage • Budget limits\nApproved region / processing profile",fillcolor="#FFE9BD"];
iac -> stage [style=dashed,label="provision authorised scope"];

}
